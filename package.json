{
  "name": "revoir",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Planifier ses révisions grâce à la répétition espacée, sans stocker le contenu à apprendre.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
